# ─────────────────────────────────────────────────────────────
# OnlyWines.pl – environment variables
# Copy to .env.local for local development. On Vercel, add them in
# Project → Settings → Environment Variables. Empty = feature disabled.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://onlywines.pl

# ── Analytics (loaded only after the visitor accepts analytics cookies)
# "plausible" (recommended), "ga4" or empty to disable
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=onlywines.pl
NEXT_PUBLIC_GA4_ID=

# ── Google AdSense (loaded only after the visitor accepts ads cookies)
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Forms
# Newsletter: form "action" URL from MailerLite / Brevo / etc.
NEXT_PUBLIC_NEWSLETTER_ACTION=
# Contact & partnership forms: Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_CONTACT=
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@onlywines.pl

# ── Affiliate partner IDs (see src/config/partners.ts)
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_VIATOR_MCID=
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_AMAZON_TAG=
# Deeplink templates for networks (Awin, Convertiser, Impact…). Use {url} as placeholder
# for the URL-encoded target, e.g. https://www.awin1.com/cread.php?awinmid=123&awinaffid=456&ued={url}
NEXT_PUBLIC_EMPIK_DEEPLINK_TEMPLATE=
NEXT_PUBLIC_SKYSCANNER_DEEPLINK_TEMPLATE=
NEXT_PUBLIC_RENTALCARS_DEEPLINK_TEMPLATE=
NEXT_PUBLIC_WSET_DEEPLINK_TEMPLATE=
